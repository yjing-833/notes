apt update && apt -y install sudo git gcc make libpcap-dev jq python3-venv
git clone https://github.com/robertdavidgraham/masscan && cd masscan && make && sudo make install && cd ../

curl https://raw.githubusercontent.com/ebrasha/cidr-ip-ranges-by-country/refs/heads/master/CIDR/vn-ipv4-Hackers.Zone.txt > rs.txt
